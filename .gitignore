# ---- Data / results ----
# The bundled example outputs are intentionally tracked:
#   data/synthetic_insitu_stack.tif, data/ground_truth.csv,
#   results/insitu_quant_summary.png and the small CSV/JSON tables.
# Ignore only ad-hoc large intermediate files.
data/*_registered*.tif
results/*.npy
results/*.npz
!data/synthetic_insitu_stack.tif
!results/insitu_quant_summary.png
